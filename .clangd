CompileFlags:
  # Basic compilation options
  Add:
    - -xc++                          # Treat all files as C++
    - -std=c++20                     # Use the C++20 standard
    - -Wall                          # Enable common warnings
    - -Wextra                        # Extra warnings
    - -Wthread-safety                # Thread-safety analysis (project uses multithreading)
    - -Wself-assign                  # Self-assignment warning
    - -Wunused-result                # Unused result warning
    - -fcolor-diagnostics            # Colored diagnostics
    - -ferror-limit=100              # Limit errors to avoid overwhelming noise
    - -Wno-sign-compare

  # Remove potentially conflicting options
  Remove:
    - -W*                           # Remove all other warning-related flags
    - -stdlib=libc++                # Remove libc++ flags to avoid conflicts with system libs
    - -Xclang                       # Remove clang-specific flags
    - -fno-cxx-modules              # Remove module-related flags
    - --gcc-toolchain=*             # Remove GCC toolchain path
  # Specify the compiler
  Compiler: ./external/toolchains_llvm++llvm+llvm_toolchain_llvm/bin/clang++  # Use the project-provided clang++

  # Compilation database search strategy
  CompilationDatabase: Ancestors    # Search for compile_commands.json in parent directories

# Index configuration
Index:
  Background: Build                 # Enable background indexing
  StandardLibrary: true             # Index the standard library

# Diagnostics configuration
Diagnostics:
  # Suppress specific diagnostics
  Suppress:
    - bugprone-easily-swappable-parameters  # Avoid noisy parameter-swappable warnings
    - bugprone-narrowing-conversions        # Common in GPU code
    - cert-err58-cpp                        # Static object constructors may throw
    - cppcoreguidelines-pro-type-vararg     # C-style varargs (used by logging macros)

  # Clang-Tidy configuration (performance-focused subset)
  ClangTidy:
    Add:
      # Key check categories
      - bugprone-*                          # Bug-prone checks
      - performance-*                       # Performance checks (important)
      - readability-identifier-naming       # Naming conventions
      - readability-redundant-*             # Redundant code
      - modernize-use-nullptr              # Use nullptr
      - modernize-use-override             # Use override
      - modernize-use-using                # Prefer using over typedef
      - modernize-deprecated-headers       # Deprecated headers
      - google-runtime-int                 # Integer type checks
      - misc-unused-*                      # Unused code
      - abseil-*                           # Abseil-related checks
      - concurrency-*                      # Concurrency-related checks

    Remove:
      # Checks disabled during editing (too slow or too noisy)
      - bugprone-easily-swappable-parameters
      - bugprone-implicit-widening-of-multiplication-result
      - performance-no-int-to-ptr          # Common in CUDA code
      - performance-unnecessary-value-param
      - performance-enum-size
      - readability-magic-numbers          # Do not enforce magic-number checks
      - readability-function-cognitive-complexity  # Complexity check is too slow
      - abseil-string-find-startswith      # May have false positives
      - modernize-use-trailing-return-type # Do not enforce trailing return type
      - modernize-avoid-c-arrays           # C arrays are common in CUDA code
      - cppcoreguidelines-*                # Too strict; prefer specific rules instead
      - fuchsia-statically-constructed-objects
      - misc-use-anonymous-namespace
      - readability-braces-around-statements
      - llvm-prefer-static-over-anonymous-namespace

    CheckOptions:
      readability-identifier-naming.VariableCase: lower_case
      readability-identifier-naming.FunctionCase: lower_case
      readability-identifier-naming.ClassCase: CamelCase
      readability-identifier-naming.StructCase: CamelCase
      readability-identifier-naming.EnumCase: CamelCase
      readability-identifier-naming.NamespaceCase: lower_case
      readability-identifier-naming.MacroCase: UPPER_CASE
      readability-identifier-naming.ParameterCase: lower_case
      readability-identifier-naming.MemberCase: lower_case
      readability-identifier-naming.ProtectedMemberCase: lower_case
      readability-identifier-naming.PrivateMemberSuffix: _
      readability-identifier-naming.ProtectedMemberSuffix: _
      readability-identifier-naming.PrivateMethodCase: lower_case
      readability-identifier-naming.PrivateMethodIgnoredRegexp: "^[a-z][a-z0-9_]*_$"
      readability-identifier-naming.VariableIgnoredRegexp: "^_[a-z][a-z0-9_]*$"
      readability-identifier-naming.LocalVariableIgnoredRegexp: "^_[a-z][a-z0-9_]*$"
      readability-identifier-naming.GlobalVariableIgnoredRegexp: "^_[a-z][a-z0-9_]*$"
      readability-identifier-naming.ConstexprVariableCase: CamelCase
      readability-identifier-naming.ConstexprVariablePrefix: k
      readability-identifier-naming.StaticConstantCase: CamelCase
      readability-identifier-naming.StaticConstantPrefix: k
      readability-identifier-naming.GlobalConstantCase: CamelCase
      readability-identifier-naming.GlobalConstantPrefix: k
      performance-move-const-arg.CheckTriviallyCopyableMove: false
      performance-unnecessary-value-param.IncludeStyle: google
      abseil-string-find-str-contains.StringLikeClasses: "std::string;std::string_view;absl::string_view"

    FastCheckFilter: None

  # Include Cleaner configuration
  UnusedIncludes: Strict           # Strictly check unused includes
  MissingIncludes: None            # Do not check missing includes for now (may be false positives)

# Code completion configuration
Completion:
  AllScopes: true                  # Include all scopes in completion

# Inlay hints configuration
InlayHints:
  Enabled: true
  ParameterNames: true             # Show parameter names
  DeducedTypes: true               # Show deduced types
  Designators: true                # Show designated initializers
  BlockEnd: false                  # Do not show block end comments (avoid visual clutter)

# Hover configuration
Hover:
  ShowAKA: true                    # Show type aliases

# Conditional configuration - test-specific settings
---
If:
  PathMatch: ".*test.*\\.(cc|cpp)" # Match test files
CompileFlags:
  Add:
    - -DUNIT_TEST                  # Define unit test macro
    - -DDEBUG                      # Enable debug
Diagnostics:
  ClangTidy:
    Remove:
      - readability-identifier-naming              # Relax naming rules in tests
      - readability-function-cognitive-complexity
    CheckOptions:
      readability-function-cognitive-complexity: 50