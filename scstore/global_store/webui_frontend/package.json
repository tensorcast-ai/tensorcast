{
  "name": "global-store-webui",
  "version": "1.0.0",
  "description": "Web UI for Global Store monitoring",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_MOCK_API=true vite",
    "predev:mock": "msw init public --save",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:mock": "vitest src/mocks/__tests__/mock-handlers.test.ts",
    "test:e2e": "playwright test",
    "test:mock-ui": "./test-mock-ui.sh",
    "test:all": "npm run test:mock && npm run test:mock-ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 5"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@tanstack/react-query": "^5.17.9",
    "antd": "^5.12.8",
    "axios": "^1.6.5",
    "dayjs": "^1.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "react-window": "^1.8.10",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.1.3",
    "msw": "^1.3.2",
    "cross-env": "^7.0.3"
  },
  "msw": {
    "workerDirectory": "public"
  }
}